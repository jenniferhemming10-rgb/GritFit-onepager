---
import { site } from "../data/site";

interface Props {
  class?: string;
  iconClass?: string;
}

const { class: className = "", iconClass = "h-5 w-5" } = Astro.props;
---

<div class={`flex items-center gap-3 ${className}`}>
  <a
    href={site.facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GritFit on Facebook"
    class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/30 transition-colors hover:bg-primary-600 hover:ring-primary-600"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass} aria-hidden="true">
      <path
        d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"
      ></path>
    </svg>
  </a>
  <a
    href={site.instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GritFit on Instagram"
    class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/30 transition-colors hover:bg-primary-600 hover:ring-primary-600"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass} aria-hidden="true">
      <path
        d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.24 2.22.41.56.21.96.47 1.38.89.42.42.68.82.89 1.38.17.42.36 1.05.41 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.8-.41 2.22-.21.56-.47.96-.89 1.38-.42.42-.82.68-1.38.89-.42.17-1.05.36-2.22.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.24-2.22-.41a3.74 3.74 0 0 1-1.38-.89 3.74 3.74 0 0 1-.89-1.38c-.17-.42-.36-1.05-.41-2.22-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.24-1.8.41-2.22.21-.56.47-.96.89-1.38.42-.42.82-.68 1.38-.89.42-.17 1.05-.36 2.22-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.5.01-4.73.07-.96.04-1.48.2-1.82.33-.46.18-.78.39-1.13.73-.34.35-.55.67-.73 1.13-.13.34-.29.86-.33 1.82-.06 1.23-.07 1.58-.07 4.73s.01 3.5.07 4.73c.04.96.2 1.48.33 1.82.18.46.39.78.73 1.13.35.34.67.55 1.13.73.34.13.86.29 1.82.33 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c.96-.04 1.48-.2 1.82-.33.46-.18.78-.39 1.13-.73.34-.35.55-.67.73-1.13.13-.34.29-.86.33-1.82.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.73c-.04-.96-.2-1.48-.33-1.82a3.02 3.02 0 0 0-.73-1.13 3.02 3.02 0 0 0-1.13-.73c-.34-.13-.86-.29-1.82-.33-1.23-.06-1.58-.07-4.73-.07Zm0 4.14a5.08 5.08 0 1 1 0 10.16 5.08 5.08 0 0 1 0-10.16Zm0 1.62a3.46 3.46 0 1 0 0 6.92 3.46 3.46 0 0 0 0-6.92Zm5.4-3.15a1.19 1.19 0 1 1 0 2.38 1.19 1.19 0 0 1 0-2.38Z"
      ></path>
    </svg>
  </a>
</div>
