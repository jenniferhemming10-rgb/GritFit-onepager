---
import { site } from "../data/site";
import SocialIcons from "./SocialIcons.astro";

const year = new Date().getFullYear();
---

<footer class="bg-neutral-950 py-10 text-neutral-400">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6 sm:flex-row sm:justify-between sm:text-left">
    <div class="flex items-center gap-2.5">
      <img src="/logo-64.png" alt="GritFit logo" width={32} height={32} class="h-8 w-8 object-contain" />
      <span class="font-display text-lg tracking-wide text-white">{site.name}</span>
      <span class="text-sm">&middot; {site.location}</span>
    </div>

    <SocialIcons />

    <p class="text-xs text-neutral-500">
      &copy; {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
